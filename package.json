{
  "name": "patina",
  "productName": "Patina",
  "version": "1.2.0",
  "description": "Patina – Minecraft-Launcher mit 1-Klick-Versionsupgrade, Mod- und Shader-Browser",
  "author": "Patina",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:ui": "vite --config renderer/vite.config.mjs",
    "build:ui": "vite build --config renderer/vite.config.mjs",
    "start": "npm run build:ui && electron .",
    "dev": "npm run build:ui && electron .",
    "test": "node test/unit.js && node test/security.js && node test/migration.js && node test/core-flow.js",
    "dist": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build:ui && electron-builder --win portable --x64"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "@fontsource/onest": "5.3.1",
    "@fontsource/pixelify-sans": "5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "de.samuelerk.patina",
    "productName": "Patina",
    "copyright": "© 2026 Patina",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Patina-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Patina",
      "uninstallDisplayName": "Patina",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "de_DE"
      ],
      "artifactName": "Patina-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Patina-Portable-${version}.${ext}"
    },
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "publish": null
  }
}
